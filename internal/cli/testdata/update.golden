$ trilium update meeting1 --title 'Weekly sync'
updated meeting1 title: "Meeting notes" → "Weekly sync"

$ trilium update script1 --type code --mime text/x-go
updated script1 type: code → code, mime: text/x-python → text/x-go

$ trilium update script1
stderr| error: nothing to update: give --title, --type or --mime
stderr| hint: example: trilium update <note> --title "New title"
exit: 2

$ trilium update _options --title x
stderr| error: _options is a Trilium system note
stderr| hint: add --force if you really mean to change it
exit: 2

$ trilium --json update meeting1 --title Again

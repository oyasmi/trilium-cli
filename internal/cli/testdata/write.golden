$ trilium get script1 -c
# header
print('hi')
print('bye')%(no newline)

$ trilium edit meeting1 --old '<p>Budget review</p>' --new '<p>Budget approved</p>' --old one --new first
edited meeting1 2 replacements: 98 → 102 bytes

$ trilium edit meeting1 --old '<li>' --new '<li>* '
stderr| error: --old #1 matches 2 times in meeting1 (nothing was changed)
stderr| hint: add more surrounding text to make it unique, or use --all to replace every match
exit: 1

$ trilium edit meeting1 --old '<li>' --new '<li>* ' --all
edited meeting1 2 replacements: 102 → 106 bytes

$ trilium edit meeting1 --old 'missing text' --new x --old Agenda --new Plan
stderr| error: --old #1 not found in meeting1 (nothing was changed)
stderr| hint: text must match exactly; text notes are raw HTML. View it with: trilium get -c meeting1
exit: 1

$ trilium edit meeting1 --old Agenda
stderr| error: got 1 --old and 0 --new
stderr| hint: pair every --old with a --new (use --new "" to delete)
exit: 2

$ trilium edit meeting1 --old '' --new x
stderr| error: --old #1 is empty; there is nothing to find
exit: 2

$ trilium edit meeting1
stderr| error: nothing to replace: give --old and --new
stderr| hint: example: trilium edit <note> --old "<p>a</p>" --new "<p>b</p>"
exit: 2

$ trilium edit meeting1 --old-file '$DIR/old.txt' --new-file '$DIR/new.txt'
edited meeting1 1 replacement: 106 → 104 bytes

$ trilium get meeting1 -c
<p>more</p><h2>Plan</h2><p>Budget approved</p><ul><li>* first</li><li>* two</li></ul><p>Action items</p>%(no newline)

$ trilium put meeting1 '<p>replaced</p>'
